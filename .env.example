# ---------------------------------------------------------
# Internal backend connection used by Next.js server routes.
# Do NOT prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------
DJANGO_INTERNAL_URL=http://127.0.0.1:8000

# ---------------------------------------------------------
# Public storefront configuration.
# These values are safe to expose to the browser.
# ---------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=My Store
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_FACEBOOK=
NEXT_PUBLIC_STORE_INSTAGRAM=
NEXT_PUBLIC_STORE_TWITTER=
